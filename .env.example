# Copie este arquivo para .env e preencha os valores

# Token secreto — qualquer string longa e aleatória (mínimo 32 caracteres)
# Gere um em: https://www.uuidgenerator.net/
APP_TOKEN=cole-aqui-um-token-secreto-longo

# Porta do servidor (Railway define automaticamente, não precisa mudar)
PORT=3000

# Caminho do banco de dados (não precisa mudar)
DB_PATH=./data/sistema.db
