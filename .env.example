# Copie este arquivo para .env e preencha os valores

# Token secreto — qualquer string longa e aleatória (mínimo 32 caracteres)
# Gere um em: https://www.uuidgenerator.net/
APP_TOKEN=cole-aqui-um-token-secreto-longo

# Porta do servidor (Railway define automaticamente, não precisa mudar)
PORT=3000

# Caminho do banco de dados (não precisa mudar)
DB_PATH=./data/sistema.db

# ── Recuperação de senha por e-mail ─────────────────────────────────────
# Endereço público do sistema — usado para montar o link enviado por e-mail
APP_URL=https://finance.aliancebrasil.com.br

# Servidor de envio (SMTP). Para Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu-email@aliancebrasil.com.br
#   SMTP_PASS=  <senha de app de 16 letras, gerada em myaccount.google.com/apppasswords>
# A senha normal da conta NÃO funciona — é preciso gerar uma "senha de app".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido (opcional; se vazio, usa o SMTP_USER)
SMTP_FROM=Sistema Financeiro <seu-email@aliancebrasil.com.br>
